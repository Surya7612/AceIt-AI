# Copy to ".env" for local development. Never commit ".env".
# On Replit: set the same keys under Tools → Secrets (no .env required in cloud).

# --- Core (required for a working deploy) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://127.0.0.1:6379/0
OPENAI_API_KEY=sk-your-key-here
FLASK_SECRET_KEY=generate-a-long-random-string

# Flask-Migrate (matches repo ".flaskenv")
FLASK_APP=main:app

# HTTPS when served over TLS (Replit published apps, etc.)
SESSION_COOKIE_SECURE=true

# --- Stripe (optional; use test keys for portfolio demos) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PREMIUM_MONTHLY_PRICE_ID=
# STRIPE_PREMIUM_YEARLY_PRICE_ID=

# --- RAG / cost tuning (optional; sensible portfolio defaults) ---
# RAG_USE_EMBEDDINGS=true
# RAG_QUERY_EXPAND=false
# RAG_LLM_RERANK=false
# RAG_EMBEDDING_POOL=24
# RAG_HYBRID_LEX_WEIGHT=0.35
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_CACHE_TTL=604800
# RAG_EMBEDDING_MAX_CHARS=6000
# RAG_EXPAND_MODEL=gpt-4o-mini
# RAG_RERANK_MODEL=gpt-4o-mini
# RAG_RERANK_POOL=12

# --- Runtime (injected by Railway; optional locally) ---
# PORT=5000
